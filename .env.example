# Copy to .env.local and adjust. All values are optional for local development.

# Path to the SQLite database (default: data/bookings.sqlite)
# DATABASE_PATH="data/bookings.sqlite"

# Private key for the legacy POST /api/bookings/[id]/complete endpoint.
# Never expose it in a NEXT_PUBLIC_* variable.
# BOOKING_ADMIN_KEY="replace-with-a-private-key"
